# Build output
target/
*.class

# IDE
.idea/
*.iml
.settings/
.classpath
.project

# .vscode/ is tracked on purpose: tasks.json/extensions.json are shared run
# configs, not personal editor state. Ignore only personal-machine overrides.
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local environment / secrets - never commit real credentials
.env
.env.*
application-local.yml
application-local.properties

# Maven wrapper cache (optional to keep, excluded to keep repo lean)
